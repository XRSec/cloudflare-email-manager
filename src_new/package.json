{
  "name": "cloudflare-email-manager-vue",
  "version": "1.0.0",
  "description": "基于Cloudflare的临时邮箱管理系统 - Vue 3 + TypeScript版本",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:worker",
    "build:frontend": "vue-tsc && vite build",
    "build:worker": "vite build --config vite.config.worker.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-vue": "^5.0.2",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "typescript": "~5.3.0",
    "vite": "^5.0.10",
    "vue-tsc": "^1.8.25",
    "wrangler": "^3.19.0"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "vue3",
    "typescript",
    "email",
    "temporary",
    "d1",
    "r2"
  ],
  "author": "Your Name",
  "license": "MIT"
}