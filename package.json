{
  "name": "cloudflare-email-manager",
  "version": "2.0.0",
  "description": "基于Cloudflare的邮箱管理系统，提供完整的邮件接收、存储、发送、转发和管理功能",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "init": "node scripts/deploy.js",
    "dev": "concurrently \"wrangler dev --remote\" \"vite vue\"",
    "build": "cd vue && vue-tsc --noEmit && vite build",
    "deploy": "npm run build && npx wrangler deploy",
    "db:export": "npx wrangler d1 export cem-db --output /tmp/d1.sqlite --remote && rm -rf d1.db && sqlite3 d1.db < /tmp/d1.sqlite"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "email",
    "temporary",
    "d1",
    "r2",
    "webhook",
    "临时邮箱",
    "vue3",
    "typescript"
  ],
  "author": "XRSec",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "26.6.11",
    "@vueuse/core": "15.1.0",
    "axios": "1.21.1",
    "dayjs": "1.11.23",
    "dompurify": "^3.5.0",
    "element-plus": "2.14.8",
    "hono": "4.13.23",
    "html-to-text": "10.0.1",
    "pinia": "^4.1.0",
    "postal-mime": "4.2.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.3",
    "vue-tsc": "3.3.14",
    "wrangler": "4.168.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261127.1",
    "@types/html-to-text": "9.0.4",
    "@vitejs/plugin-vue": "6.0.11",
    "concurrently": "10.0.7",
    "vite": "8.4.0",
    "vite-plugin-vue-devtools": "8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XRSec/cloudflare-email-manager.git"
  },
  "bugs": {
    "url": "https://github.com/XRSec/cloudflare-email-manager/issues"
  },
  "homepage": "https://github.com/XRSec/cloudflare-email-manager#readme"
}
