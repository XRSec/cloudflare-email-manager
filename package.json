{
  "name": "cloudflare-email-manager",
  "version": "2.0.0",
  "description": "基于Cloudflare的邮箱管理系统，提供完整的邮件接收、存储、发送、转发和管理功能",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npx concurrently \"npm run build:frontend\" \"npm run build:worker\"",
    "build:frontend": "cd frontend && npx vite build",
    "build:worker": "cd worker && npx tsc",
    "preview": "cd frontend && npx vite preview",
    "deploy": "node scripts/deploy.js",
    "init": "cd worker && node deploy.js",
    "clean": "cd worker && node deploy.js deleteAll",
    "db": "node scripts/db.js",
    "db:init": "node scripts/db.js init",
    "db:init:remote": "node scripts/db.js init --remote",
    "db:migrate": "node scripts/db.js migrate",
    "db:import": "node scripts/db.js import",
    "docker": "node scripts/docker.js",
    "docker:start": "node scripts/docker.js start",
    "docker:stop": "node scripts/docker.js stop",
    "docker:restart": "node scripts/docker.js restart",
    "docker:remove": "node scripts/docker.js remove",
    "docker:status": "node scripts/docker.js status",
    "docker:build": "node scripts/docker.js build",
    "lint": "npx concurrently \"npm run lint:frontend\" \"npm run lint:worker\"",
    "lint:frontend": "cd frontend && npx eslint . --fix",
    "lint:worker": "cd worker && npx eslint src --ext .ts,.js --fix",
    "format": "npx concurrently \"npm run format:frontend\" \"npm run format:worker\"",
    "format:frontend": "cd frontend && npx prettier --write src/",
    "format:worker": "cd worker && npx prettier --write src/",
    "type-check": "npx concurrently \"npm run type-check:frontend\" \"npm run type-check:worker\"",
    "type-check:frontend": "cd frontend && npx vue-tsc --build",
    "type-check:worker": "cd worker && npx tsc --noEmit",
    "postinstall": "node ./scripts/install-wrangler.js",
    "predev": "docker exec node bash -c 'kill -9 $(pidof node) || true'"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "email",
    "temporary",
    "d1",
    "r2",
    "webhook",
    "临时邮箱",
    "vue3",
    "typescript"
  ],
  "author": "XRSec",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250909.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.5",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  },
  "dependencies": {
    "@bamblehorse/tiny": "^2.0.0",
    "@iarna/toml": "^2.2.5",
    "@vicons/fa": "^0.13.0",
    "@vicons/material": "^0.13.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.0",
    "hono": "^4.9.6",
    "naive-ui": "^2.42.0",
    "npm-check-updates": "^18.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1",
    "yarn": "^1.22.22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XRSec/cloudflare-email-manager.git"
  },
  "bugs": {
    "url": "https://github.com/XRSec/cloudflare-email-manager/issues"
  },
  "homepage": "https://github.com/XRSec/cloudflare-email-manager#readme"
}