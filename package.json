{
  "name": "cloudflare-email-manager",
  "version": "2.0.0",
  "description": "基于Cloudflare的邮箱管理系统，提供完整的邮件接收、存储、发送、转发和管理功能",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "init": "node scripts/deploy.js",
    "dev": "concurrently \"wrangler dev --remote\" \"vite vue\"",
    "build": "cd vue && vue-tsc --noEmit && vite build",
    "deploy": "npm run build && npx wrangler deploy",
    "db:export": "npx wrangler d1 export cem-db --output /tmp/d1.sqlite --remote && rm -rf d1.db && sqlite3 d1.db < /tmp/d1.sqlite"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "email",
    "temporary",
    "d1",
    "r2",
    "webhook",
    "临时邮箱",
    "vue3",
    "typescript"
  ],
  "author": "XRSec",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "25.5.2",
    "@vueuse/core": "12.0.0",
    "axios": "1.16.0",
    "dayjs": "1.11.20",
    "element-plus": "2.13.6",
    "hono": "4.12.12",
    "html-to-text": "9.0.5",
    "pinia": "^3.0.4",
    "postal-mime": "2.7.4",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.0.0",
    "vue": "3.5.32",
    "vue-router": "5.0.4",
    "vue-tsc": "3.2.6",
    "wrangler": "4.81.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260409.1",
    "@types/html-to-text": "9.0.4",
    "@vitejs/plugin-vue": "6.0.5",
    "concurrently": "9.2.1",
    "vite": "8.0.8",
    "vite-plugin-vue-devtools": "8.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XRSec/cloudflare-email-manager.git"
  },
  "bugs": {
    "url": "https://github.com/XRSec/cloudflare-email-manager/issues"
  },
  "homepage": "https://github.com/XRSec/cloudflare-email-manager#readme"
}
