
   @media (max-width: 768px) {
        .sidebar {
            width: 50%;
            left: -100%;
        }

        .sidebar .sidebar-header {
            position: relative;
        }

        /* 手机端关闭按钮 - 放在侧边栏底部 */
        .sidebar .sidebar-footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding-bottom: 15px;
        }

        .sidebar .sidebar-footer .btn {
            width: 100%;
            margin-bottom: 10px;
        }

        /* 确保侧边栏菜单有足够的底部空间 */
        .sidebar .sidebar-menu {
            padding-bottom: 120px; /* 为底部按钮留出空间 */
        }

        .top-bar > div > .btn-sm {
            padding: 10px 20px;
            margin: 3px 10px;
        }

        #emailsSection, .card {
            padding: 10px
        }

        #emailsSection > div > .card-header {
            padding: 6px;
        }

        #emailsSection > div > div > h2 {
            margin-bottom: 10px;
        }

        .top-bar .btn:first-child {
            // display: block;
        }

        .sidebar.open ~ .main-content .top-bar .btn:first-child {
            display: none;
        }

        .sidebar.open {
            left: 0;
        }

        /* 手机端邮件控制按钮优化 */
        .email-controls {
            flex-direction: column;
            gap: 8px;
            // margin-bottom: 15 px;
        }

        .card-actions {
            padding: 0;
        }

        .email-controls .btn {
            width: auto;
            padding: 6px;
            margin: 6px;
        }

        /* 手机端卡片内容优化 */
        .card-body {
            padding: 6px;
        }

        /* 手机端邮件列表优化 */
        .email-item {
            margin-bottom: 10px;
            padding: 6px;
        }

        .email-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }

        .email-sender {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .email-time {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .email-subject {
            font-size: 0.9rem;
            margin: 8px 0;
        }

        .email-preview {
            font-size: 0.8rem;
            line-height: 1.4;
        }

        .email-actions {
            flex-direction: column;
            gap: 8px;
            margin-top: 10px;
        }

        .email-actions .btn {
            width: auto;
            font-size: 0.8rem;
            padding: 8px 12px;
        }
        .text-content, .html-content, .email-details.expanded {
            // max-height: max-content;
        }

        /* 手机端搜索框优化 */
        .search-box {
            margin-bottom: 15px;
        }

        .search-input {
            font-size: 16px; /* 防止iOS缩放 */
            padding: 12px;
        }

        /* 手机端表格优化 */
        .table-responsive {
            font-size: 0.8rem;
        }

        .table th,
        .table td {
            padding: 8px 4px;
        }

        /* 手机端模态框优化 */
        .modal-content {
            margin: 10px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 20px;
            width: calc(100vw - 20px);
            max-width: none;
        }

        .modal-header h3 {
            font-size: 18px;
            margin-bottom: 15px;
            text-align: center;
        }

        .modal-body {
            // padding: 15px 0;
        }

        .modal-footer {
            margin-top: 0;
            padding: 10px 0;
            flex-direction: column;
            gap: 8px;
        }

        .modal-footer .btn {
            width: auto;
        }

        /* 手机端模态框内表单元素优化 */
        .modal-content .form-control {
            font-size: 16px; /* 防止iOS缩放 */
            padding: 12px;
            margin-bottom: 15px;
        }

        .modal-content .form-label {
            font-size: 14px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .modal-content select.form-control {
            font-size: 16px;
            padding: 12px;
            background-color: white;
        }

        .modal-content textarea.form-control {
            font-size: 16px;
            padding: 12px;
            min-height: 120px;
            resize: vertical;
        }

        /* 手机端选择器下拉框优化 */
        .modal-content .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.2);
        }

        /* 手机端表单组优化 */
        .modal-content .form-group {
            margin-bottom: 20px;
        }

        .modal-content .form-group:last-child {
            margin-bottom: 0;
        }

        /* 手机端选择器特殊优化 */
        .modal-content select {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6,9 12,15 18,9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 16px;
            padding-right: 40px;
        }

        /* 手机端按钮优化 */
        .modal-footer .btn {
            width: 100%;
            padding: 12px 20px;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .modal-footer .btn:last-child {
            margin-bottom: 0;
        }

        .main-content.sidebar-open {
            margin-left: 0;
        }

        .container {
            padding: 10px;
            max-width: 100%;
        }

        .header h1 {
            font-size: 2rem;
        }

        .form-row {
            flex-direction: column;
            gap: 10px;
        }
    }

    /* 电脑端隐藏关闭按钮 */
    @media (min-width: 769px) {
        .sidebar .sidebar-footer {
            // display: none;
        }

        .sidebar .sidebar-menu {
            padding-bottom: 20px; /* 电脑端恢复正常间距 */
        }
    }

    @media (max-width: 480px) {
        .card {
            padding: 3px;
        }

        .btn {
            width: auto;
            margin-bottom: 10px;
            padding: 5px 8px;
        }

        .table {
            margin-top: unset;
            font-size: small;
            display: inline-table;
            white-space: nowrap;
            width: auto;
        }
    }