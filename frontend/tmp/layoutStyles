


    .card {
        background: white;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .card h2 {
        margin-bottom: 20px;
        color: #2c3e50;
    }

    .header {
        text-align: center;
        padding: 40px 0;
        // color: white;
    }

    .header h1 {
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }

    /* 侧边栏样式 */
    .sidebar {
        position: fixed;
        left: -250px;
        top: 0;
        width: 250px;
        height: 100vh;
        background: #2c3e50;
        transition: left 0.3s ease;
        z-index: 1000;
        overflow-y: auto;
    }

    .sidebar.open {
        left: 0;
    }

    .sidebar-header {
        padding: 20px;
        background: #1a252f;
        color: white;
    }

    .sidebar-header h3 {
        margin: 0;
    }

    .sidebar-menu {
        padding: 10px 0;
    }

    .sidebar-item {
        display: block;
        padding: 15px 20px;
        color: #ecf0f1;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.3s;
    }

    .sidebar-item:hover, .sidebar-item.active {
        background: #34495e;
        border-right: 4px solid #667eea;
    }

    .main-content {
        transition: margin-left 0.3s ease;
        min-height: 95vh;
    }

    .main-content.sidebar-open {
        margin-left: 250px;
    }
    .sidebar .sidebar-footer .btn-secondary {
        margin-bottom: 10px;
        display: block;
        padding: 8px 20px;
        text-decoration: none;
        color: #ecf0f1;
        cursor: pointer;
        transition: background 0.3s;
        border-top: 1px solid #f39c12;
        // box-shadow: 0 3px 6px rgba(0, 0, 0, 0.5);
    }
    .sidebar .sidebar-footer .btn-secondary:hover {
        background: #34495e;
        color: #667eea;
        border-right: 4px solid #667eea;
    }